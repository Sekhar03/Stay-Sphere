# -------------------------------------------------------------
# StaySphere Environment Configuration
# -------------------------------------------------------------

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (PostgreSQL with PgBouncer / direct)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/staysphere?schema=public"

# Authentication & Session (generate with `openssl rand -base64 32`)
JWT_SECRET="staysphere_super_secure_jwt_secret_key_production_grade_32chars_min"
COOKIE_SECRET="staysphere_secure_cookie_secret_salt_keys_2026"

# UPI Gateway Configuration (mynkdev-21/upi-gateway)
# Host your own instance or point to your deployed gateway
UPI_GATEWAY_URL="http://localhost:8000"
UPI_GATEWAY_API_KEY="key_xxx"
UPI_GATEWAY_API_SECRET="sec_xxx"
UPI_GATEWAY_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_UPI_ID="sekhar.parida@ptaxis"
NEXT_PUBLIC_UPI_NAME="Sekhar Parida"

# Google Maps Platform (Maps JS, Places API, Routes / Distance Matrix API)
# Get credentials at https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSy_StaySphere_GoogleMaps_ApiKey_ReplaceWithYours"

# Redis Connection (BullMQ jobs & session caching)
REDIS_URL="redis://localhost:6379"

# Transactional Email (Resend or SMTP)
EMAIL_FROM="StaySphere <no-reply@staysphere.in>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASS="re_staysphere_dummy_or_live_smtp_key"

# Cloud Object Storage (AWS S3 or Cloudinary for 360° Panoramas & 3D GLB assets)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="AKIA_STAYSPHERE_EXAMPLE_KEY"
AWS_SECRET_ACCESS_KEY="staysphere_secret_access_key"
AWS_S3_BUCKET="staysphere-property-assets"
# If using Cloudinary:
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
